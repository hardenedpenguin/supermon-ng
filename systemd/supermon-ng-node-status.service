[Unit]
Description=Supermon-NG Node Status Update Service
After=network.target asterisk.service
Wants=asterisk.service

[Service]
Type=oneshot
User=root
WorkingDirectory=APP_DIR_PLACEHOLDER/sbin
ExecStart=/usr/bin/python3 APP_DIR_PLACEHOLDER/sbin/ast_node_status_update.py
StandardOutput=append:/var/log/supermon-ng/node-status-update.log
StandardError=append:/var/log/supermon-ng/node-status-update.log

[Install]
WantedBy=multi-user.target
