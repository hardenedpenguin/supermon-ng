# Application environment
APP_ENV=production
APP_DEBUG=false

# URL path prefix (install/update patches index.html + Apache from this):
#   /supermon-ng = app under main site (default)
#   /            = dedicated vhost at site root (e.g. sm.example.com)
APP_BASE_PATH=/supermon-ng

# Dedicated vhost only: hostname for Apache ServerName (install/update regenerates template)
# SUPERMON_SERVER_NAME=sm.w5gle.net

# TLS: Certbot certificate name (live dir under /etc/letsencrypt/live/NAME/); auto-detected if unset
# SSL_CERT_NAME=w5gle.net

# Filesystem paths (defaults shown)
# APP_ROOT=/var/www/html/supermon-ng
# USER_FILES_PATH=/var/www/html/supermon-ng/user_files/
# DB_PATH=database/supermon-ng.db

# Node status systemd timer interval in minutes (default 5; install/update rewrites timer unit)
# NODE_STATUS_INTERVAL_MINUTES=5

# TRUST_FORWARDED_PROTO: enable only when a TLS-terminating reverse proxy
# strips/sanitizes client-supplied X-Forwarded-Proto and writes the real
# external scheme. That lets session cookies get the Secure flag correctly.
# Leave false (default) if Apache terminates TLS itself, or if the proxy
# passes through untrusted client forwarded headers (spoof risk).
# TRUST_FORWARDED_PROTO=false

# Comma-separated browser Origins allowed for credentialed CORS (dev defaults if unset).
# Do not use * with credentials in production.
# CORS_ORIGINS=https://sm.example.com

# API rate limit per client IP (shared across FPM workers when php-apcu is installed).
# API_RATE_LIMIT=200
# API_RATE_LIMIT_WINDOW=60

# Allow unauthenticated WebSocket status connections (default true for public monitoring).
# WEBSOCKET_ALLOW_UNAUTHENTICATED=true
